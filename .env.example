# Tỷ Tỷ Environment Variables
# Copy this file to .env and fill in your values

# ===== AI Service Configuration =====
# AI Provider: "gemini", "ollama", or "auto" (try Ollama first, fallback to Gemini)
AI_PROVIDER=auto

# Required: Google Gemini API Key (free)
# Get yours at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Optional: Ollama Local AI Service
# Base URL for Ollama service (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Ollama model to use (default: qwen2.5:0.5b - lightweight for CPU)
OLLAMA_MODEL=qwen2.5:0.5b

# ===== Camera Settings =====
# Optional: Camera Settings (for RTSP audio capture)
CAMERA_IP=
CAMERA_USERNAME=admin
CAMERA_PASSWORD=

# ===== Audio Configuration =====
# Operation Mode: "basic", "full_automation", or "hybrid"
OPERATION_MODE=basic

# ===== Wake Word Configuration =====
# Path to wake word models directory
WAKE_WORD_MODEL_PATH=./models/wake_word

# ===== Logging Configuration =====
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
